{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Menreiki",
  "version": "0.1.1",
  "identifier": "dev.menreiki.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Menreiki",
        "width": 1440,
        "height": 920
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["mnrk"],
        "name": "Menreiki Project",
        "description": "Menreiki project",
        "role": "Editor"
      }
    ],
    "resources": {
      "../../../vendor/pdfium/pdfium.dll": "pdfium.dll",
      "../../../docs/THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../../../LICENSE-MIT": "LICENSE-MIT",
      "../../../LICENSE-APACHE": "LICENSE-APACHE"
    }
  }
}
